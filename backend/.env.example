# Example backend environment configuration
# Copy this file to .env for local development

ENVIRONMENT=development
APP_NAME=Customer Intelligence Platform API

# Postgres connection (local dev uses the host port docker-compose.yml maps to 5433)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=cip_user
POSTGRES_PASSWORD=cip_password
POSTGRES_DB=cip_db

# Kafka connection (local dev uses the host port docker-compose.yml maps to 9092)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_MERCHANT_EVENTS_TOPIC=cip.merchant.events
KAFKA_SHOPPER_EVENTS_TOPIC=cip.shopper.events
KAFKA_CAMPAIGN_EVENTS_TOPIC=cip.campaign.events
KAFKA_PRODUCT_EVENTS_TOPIC=cip.product.events
KAFKA_MERCHANT_CONSUMER_GROUP_ID=cip-merchant-event-consumer
KAFKA_PRODUCT_CONSUMER_GROUP_ID=cip-product-event-consumer
KAFKA_SHOPPER_CONSUMER_GROUP_ID=cip-shopper-event-consumer
KAFKA_CAMPAIGN_CONSUMER_GROUP_ID=cip-campaign-event-consumer

# Merchant event generator (backend/scripts/run_merchant_generator.py)
MERCHANT_GENERATOR_POPULATION_SIZE=50
MERCHANT_GENERATOR_TICK_INTERVAL_SECONDS=5.0
